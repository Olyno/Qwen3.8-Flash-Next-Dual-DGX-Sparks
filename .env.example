# ============================================================================
# Qwen3.8-Flash-Next-NVFP4 — vLLM Multi-Node Config (DGX Spark)
# ============================================================================
# Based on: https://github.com/getrefined/Qwen3.8-Flash-Next-NVFP4-vLLM-DGX-Spark
# Copy to .env and adjust for your cluster.
#
# .env carries ONLY machine truth: cluster identity, interfaces, secrets.
# Serving config (model, image, KV dtype, MTP, ports, ...) lives in the
# recipes — recipes/prod.yaml is the default start.sh boots when RECIPE is
# unset, and a recipe wins over .env for every key it sets, so serving values
# here would be dead config. To change a serving knob, edit the recipe (or
# add your own next to prod.yaml) and boot it:  RECIPE=<name> ./start.sh

# -- Topology ------------------------------------------------------------------
NODES=1                                 # 1 = single Spark, 2 = head + worker

# -- Cluster Networking -------------------------------------------------------
HEAD_IP="10.0.0.1"
WORKER_IP="10.0.0.2"                    # only used when NODES=2
WORKER_USER=""                          # SSH user on worker (blank = same as head)

# -- Network Interface ---------------------------------------------------------
# Run: ip -o -4 addr | grep <subnet>   to find your interface name.
# ConnectX ports on DGX Spark often use np0/np1 suffixes (e.g. enp1s0f0np0).
IFACE="enp1s0f0np0"                     # Inter-node ethernet interface

# -- InfiniBand ----------------------------------------------------------------
# Exact-match single device for NCCL. NEVER list a port cabled to another cluster.
# Run: ibstat | grep "Port "           to find your HCA device name.
IB_HCA="=rocep1s0f0"                   # Single device, exact match (leading =)
IB_GID_INDEX=3                          # Usually 3 on ConnectX with RoCE; if 3 does not come up, try 5
                                        # Shared by BOTH nodes — there is no per-node override.
# Cross-wired cabling (head port f1 ↔ worker port f0) can give the link a
# different interface/HCA name on the worker. Both default to IFACE/IB_HCA;
# set them only then:
# WORKER_IFACE="enp1s0f1np1"
# WORKER_IB_HCA="=rocep1s0f1"

# -- Debugging (optional) ------------------------------------------------------
# NCCL log level inside the vLLM containers. launch.sh defaults it to WARN at
# NODES=1 and INFO at NODES=2 (first dual boot: the NET/IB bring-up is logged);
# set it here to override either way.
# NCCL_DEBUG=INFO

# -- Secrets -------------------------------------------------------------------
# HF_TOKEN=""                           # required for ABLIT=1 (gated repo). Uncomment and set,
                                        # then accept the terms on
                                        # https://huggingface.co/drowzeys/keys-Qwen3.8-Flash-Next-NVFP4-dual-ablit-house-qsa-L3-47

# -- ABLIT (optional) ----------------------------------------------------------
# ABLIT=1 serves the gated Keys house QSA o_proj L3-47 checkpoint (see
# HF_TOKEN above). Prefer the per-run form (ABLIT=1 ./start.sh); setting it
# here sticks it to every launch, including plain ./download.sh.
# ABLIT=0

# -- HuggingFace cache (optional) ----------------------------------------------
# Defaults to ~/.cache/huggingface on the head. The worker uses the same
# absolute path unless that path lives under $HOME (then the prefix is
# rewritten to the worker's $HOME). Set WORKER_HF_HOME only if the worker
# cache differs.
# HF_HOME="/data/hf"
# WORKER_HF_HOME="/data/hf"

# -- Weight distribution (optional) --------------------------------------------
# NFS_SERVER_IP is only consulted when a recipe sets nfs_share: "true".
# Leave unset to auto-detect from IFACE (this box: 10.0.22.1).
# NFS_SERVER_IP="10.0.22.1"
