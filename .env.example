# .env.example — per-machine config. COPY TO .env (gitignored) on every node.
#
# start.sh + stop.sh SOURCE .env (if present) before anything else: this is
# where the PAIR IDENTITY lives (HEAD_IP/WORKER_IP below) and where an
# operator overrides recipe pins. Precedence:
#   exported env  >  .env  >  recipes/$RECIPE.conf  >  recipes/peers.conf  >  engine default
# Engine pins (IMAGE digest, CKPT_SHA256, model, spec stack) live in recipes/.
# Recipe keys are enforced by tests/recipe_lint.sh.

#
# --- which stack -------------------------------------------------------------
RECIPE=prod                   # recipes/<name>.conf; arm-a1|arm-a4 for the bench ladder
CONTAINER=vllm-fn-prod        # docker name; default vllm-fn-$RECIPE
PORT=8888                     # API port (single node / rank 0)
# --- checkpoint --------------------------------------------------------------
MODEL_PATH=$HOME/models/q38-lean-hyb   # local dir; WINS over MODEL_ID (hub cache)
# MODEL_ID=nvidia/Qwen3.8-Flash-Next-NVFP4   # hub id when MODEL_PATH is unset
# HF_CACHE_DIR=$HOME/.cache/huggingface      # hub cache root for MODEL_ID
# --- memory shaping (engine/budget.sh) ----------------------------------------
# GPU_MEMORY_UTILIZATION is DERIVED from weights+KV+host reserve by default.
# Setting it here PINS it — start.sh warns and recomputes KV around the pin.
# GPU_MEMORY_UTILIZATION=0.7
KV_CACHE_DTYPE=fp8_e4m3       # auto = bf16; fp8 needs files/patch_qsa_fp8_kv_v030.py (start.sh wires it)
PLE_MODE=mmap                 # mmap (proven) | pinned (REFUSED on <=128G) | off
# FP8DENSE=1                  # hybrid/lean ckpts: mount files/{model,mtp,hyperconnection}.py over the image
# --- watchdog (files/memwatch.sh floors) --------------------------------------
MEMWATCH_MIN_GIB=3            # kill container below this MemAvailable
MEMWATCH_MIN_FREE_GIB=1       # debounce floor
# MEMWATCH_LOG=$PWD/logs/memwatch-<container>.log
# --- dual pair ---------------------------------------------------------------
# With HEAD_IP+WORKER_IP set, detect.sh switches to EXPLICIT-PAIR mode: the
# node holding HEAD_IP becomes rank 0 (head), the one holding WORKER_IP rank 1.
# No /30 prefix convention needed (gx10 runs 10.200.0.0/30). start.sh on the
# HEAD orchestrates everything: it ssh's to the worker, ships the image
# (docker save|load, first run), rsyncs the checkpoint + this repo dir, then
# launches rank 1 --headless, 15 s later launches rank 0 and serves HTTP.
# ./stop.sh on the head then stops worker first, head second. The worker only
# needs: same $HOME, docker, ssh key auth from the head, and this .env file
# (start.sh rsyncs the repo dir INCLUDING .env).
HEAD_IP=10.200.0.1           # rank 0 (head), fabric address
WORKER_IP=10.200.0.2         # rank 1 (headless worker), fabric address
WORKER_USER=olyno             # ssh user on the worker (blank = current user)
IFACE=enp1s0f0np0             # fabric interface BOTH nodes (NCCL socket ifname)
IB_HCA==rocep1s0f0            # NCCL_IB_HCA ('=' = exact device match)
IB_GID_INDEX=3                # NCCL_IB_GID_INDEX (ConnectX RoCE: usually 3)
RECIPE=pair                   # dual product: recipes/pair.conf
# SYNC_WEIGHTS=1              # head rsyncs MODEL_PATH to the worker if absent (default)
# RUN_WORKER=1                # 0 = head-only (launch on the worker yourself)
# FABRIC_NET=192.168.100      # override the /30 auto-detect prefix (no .env pairs)
# YARN=1                     # rope-scale beyond native 262144 (needs MAX_MODEL_LEN>262144 + YARN_FACTOR)
# YARN_FACTOR=4.0            # 262144 x 4 = ~1M ctx; auto-merged into HF_OVERRIDES text_config.rope_parameters
# --- escape hatches ----------------------------------------------------------
# DOCKER_ARGS_EXTRA=""        # verbatim extra docker flags (space-split)
# EXTRA_VLLM_ARGS=""          # verbatim extra vllm serve args
# V030_BREAKABLE_CUDAGRAPH=1   # re-enable v0.30 breakable graphs (default OFF: +-15% decode noise on GB10)
