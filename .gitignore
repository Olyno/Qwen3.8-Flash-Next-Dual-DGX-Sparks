# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Temp / runtime artifacts
*.pid
tmp/
*.tmp
.last_head_launch.sh

# Generated by start.sh from the resolved checkpoint snapshot
patches/config_patched.json
patches/hf_quant_config_patched.json

# Extracted verbatim from the vLLM image by start.sh, then patched in place.
# Both sides are regenerated on every launch; the generators in patches/patch_*.py
# are the source of truth.
*.orig
patches/mtp_patched.py
patches/modelopt_patched.py
patches/qsa_ops_patched.py
patches/mtp_v030_patched.py
patches/v030_fp8kv/
patches/qsa_nvidia_patched.py
overlays/fp8dense/*.py
!overlays/fp8dense/apply_patches.py
overlays/qsa_gb10/qsa.py
patches/block_drop/
patches/determinism/

# Draft vocabularies are built from a corpus (scripts/build_draft_vocab.py);
# see README "Reduced-vocabulary MTP drafting".
vocab/draft_vocab_*.txt
# ...except the shipped code-tuned vocabulary (47,149 ids), which makes the
# MTP_DRAFT_VOCAB default in the recipes work out of the box. Generated
# vocabularies stay untracked.
!vocab/draft_vocab_en_code_47k.txt
# Language-extended variants (65,536 rows each, the 47k floor + that
# language's Wikipedia; built by scripts/build_draft_vocab_extend.py, the
# single-Spark recipe's ES method). For deployments serving that language's
# traffic; see README "Reduced-vocabulary MTP drafting".
!/vocab/draft_vocab_es_en_code_65k.txt
!/vocab/draft_vocab_zh_en_code_65k.txt
!/vocab/draft_vocab_ja_en_code_65k.txt
!/vocab/draft_vocab_de_en_code_65k.txt
!/vocab/draft_vocab_pt_en_code_65k.txt
!/vocab/draft_vocab_fr_en_code_65k.txt
!/vocab/draft_vocab_ru_en_code_65k.txt
patches/v030_ple/
patches/gb10_skinny_gemm/low_latency_gemm.py
patches/v030_gdn/
patches/v030_qsa_fused/
